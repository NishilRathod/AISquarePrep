# Environment / secrets
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*

# Node
node_modules/
dist/
build/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Climate-normals fetch state: the v1 per-window checkpoints and the v2 daily
# cache. Build inputs, not artefacts -- the packed climate_normals.bin.gz is
# what ships. The v2 cache reaches tens to hundreds of MB.
app/data/.climate_normals.*.jsonl

# Runtime state for the SessionStart fetch hook: the lock that stops two
# sessions fetching at once, and the log its subprocess writes to.
app/data/.normals_fetch.lock
app/data/.normals_fetch.log

# Artefact of a bad ~ expansion: a tool wrote to a literal "~" directory in
# the repo root instead of the home directory. It holds an embedded git repo,
# so committing it produces a gitlink no clone can resolve.
~/
