# Required: get a free key at https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=changeme

OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_MAX_CALLS_PER_MINUTE=60
OPENWEATHER_TIMEOUT_SECONDS=5.0
OPENWEATHER_MAX_RETRIES=2
OPENWEATHER_BACKOFF_BASE_SECONDS=1.0

# Local (non-Docker) default. docker-compose.yml overrides this to redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=600

# Seed list only. Cities added through the UI persist in Redis (tracked:cities)
# and are appended after these.
TRACKED_CITIES=London,Paris,New York,Tokyo,Sydney,Davangere

DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=50

# --- Global anomaly board -------------------------------------------------
# Open-Meteo needs no API key. It feeds only the anomaly sweep; tracked-city
# readings still come from OpenWeather.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_TIMEOUT_SECONDS=60.0
OPEN_METEO_MAX_RETRIES=2
OPEN_METEO_BACKOFF_BASE_SECONDS=2.0

# The sweep is global scheduled work. Its first run is one full interval after
# startup; POST /anomalies/refresh populates the board immediately.
ANOMALY_SWEEP_ENABLED=true
ANOMALY_SWEEP_INTERVAL_SECONDS=10800
ANOMALY_SWEEP_BATCH_SIZE=200
ANOMALY_BOARD_SIZE=50
ANOMALY_DEFAULT_LIMIT=10

# Optional. Without a key the board still computes and ranks; it just carries
# no briefing. Leave blank rather than removing, so the degraded path is the
# obvious default rather than a surprise.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANOMALY_BRIEFING_CACHE_TTL_SECONDS=21600

# Browser origins allowed to call the API (the Vite dev server by default).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tracing. The endpoint is the switch: leave it blank and no tracer provider is
# installed, so the spans throughout the app become no-ops. Under docker compose
# this is set to the jaeger service; running the app on the host instead, point
# it at the published port and read the traces at http://localhost:16686.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=weather-cache-service

APP_ENV=local
